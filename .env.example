# === Cấu hình hệ thống order hộ (copy thành .env rồi sửa) ===

# Đường dẫn file SQLite (tương đối repo hoặc tuyệt đối). Sẵn sàng đổi khi lên VPS.
DATABASE_PATH=./data/app.sqlite

# Thư mục lưu file ảnh (DB chỉ lưu tên file, ảnh nằm ở đây).
UPLOADS_PATH=./uploads

# 2 tài khoản đăng nhập cố định, dạng: user:pass,user:pass
APP_ACCOUNTS=niên:doimatkhau1,vợ:doimatkhau2

# Khoá ký cookie phiên đăng nhập. Đổi thành chuỗi ngẫu nhiên dài.
# Gợi ý tạo: openssl rand -hex 32
SESSION_SECRET=doi-thanh-chuoi-ngau-nhien-that-dai

# Ngưỡng cảnh báo: đơn đứng quá số ngày này thì nổi lên đầu danh sách.
STALE_ORDER_DAYS=7

# Job tra tracking chạy mỗi bao nhiêu phút (spec: 4 tiếng = 240). Đặt 0 để tắt
# (khi lên VPS dùng cron ngoài gọi POST /api/cron/track).
TRACKING_SWEEP_MINUTES=240

# Bí mật cho cron ngoài gọi /api/cron/track?secret=... (để trống nếu chưa dùng).
CRON_SECRET=

# (Phase 5) Google AI Studio (Gemini) — đọc ảnh chốt đơn Zalo.
# Lấy key miễn phí tại https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model đọc ảnh (mặc định gemini-flash-latest — luôn trỏ bản Flash mới nhất).
GEMINI_MODEL=gemini-flash-latest
