# === Cấu hình hệ thống order hộ (copy thành .env rồi sửa) ===

# === Postgres (Supabase) ===
# Runtime dùng Transaction pooler (port 6543, IPv4 miễn phí, bắt buộc cho serverless/Vercel).
DATABASE_URL=postgresql://postgres.xxxx:MATKHAU@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
# Migration/pg_dump dùng Session pooler (port 5432, cũng IPv4 miễn phí). KHÔNG dùng "Direct
# connection" thật (host db.xxxx.supabase.co) — free tier chỉ chạy qua IPv6.
DIRECT_URL=postgresql://postgres.xxxx:MATKHAU@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Tài khoản HẠT GIỐNG — chỉ dùng cho lần chạy ĐẦU TIÊN, khi bảng `users` còn
# rỗng. Sau lần đó bảng `users` là nguồn chân lý; thêm/xoá tài khoản làm ở
# màn /admin/users, biến này không còn tác dụng.
# Người ĐẦU TIÊN trong danh sách nhận vai trò admin.
APP_ACCOUNTS=niên:doimatkhau1,vợ:doimatkhau2

# Khoá ký cookie phiên đăng nhập. Đổi thành chuỗi ngẫu nhiên dài.
# Gợi ý tạo: openssl rand -hex 32
SESSION_SECRET=doi-thanh-chuoi-ngau-nhien-that-dai

# Ngưỡng cảnh báo: đơn đứng quá số ngày này thì nổi lên đầu danh sách.
STALE_ORDER_DAYS=7

# Bí mật cho GitHub Actions gọi POST /api/cron/track?secret=... (quét tracking mỗi 4h).
CRON_SECRET=

# === Supabase Storage (ảnh) ===
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=photos

# (Phase 5) Google AI Studio (Gemini) — đọc ảnh chốt đơn Zalo.
# Lấy key miễn phí tại https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model đọc ảnh (mặc định gemini-flash-latest — luôn trỏ bản Flash mới nhất).
GEMINI_MODEL=gemini-flash-latest
